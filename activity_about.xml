<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FC">

    <!-- About Page App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#403064"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="About Flylune"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable About Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Premium Flylune Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#403064"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✈"
                    android:textColor="#EAD5FF"
                    android:textSize="48sp"
                    android:gravity="center"
                    android:layout_marginTop="25dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beyond the Baggage."
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A smarter way to travel, one calculation at a time."
                    android:textColor="#E1D5F1"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="15dp" />

            </LinearLayout>

            <!-- Developer Boarding Pass -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:elevation="3dp"
                android:padding="22dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✈  DEVELOPER BOARDING PASS"
                    android:textColor="#6753AA"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E7DFF2"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="20dp" />

                <!-- Developer Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSENGER / DEVELOPER"
                    android:textColor="#8A7B9D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NURUL AINA ADIBAH BINTI ABDUL HALIM"
                    android:textColor="#403064"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <!-- Student Number and Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="25dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STUDENT NUMBER"
                            android:textColor="#8A7B9D"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025429078"
                            android:textColor="#403064"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLASS / GROUP"
                            android:textColor="#8A7B9D"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RCDCS240 5A"
                            android:textColor="#403064"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Programme and Project -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROGRAMME CODE"
                            android:textColor="#8A7B9D"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CS240"
                            android:textColor="#403064"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROJECT"
                            android:textColor="#8A7B9D"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Flylune"
                            android:textColor="#403064"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Boarding Pass Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D5C9EA"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✈  READY FOR TAKEOFF"
                    android:textColor="#6753AA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- About Application Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:elevation="2dp"
                android:padding="22dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✈  About the Application"
                    android:textColor="#403064"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Flylune is a mobile application that helps air travellers estimate excess baggage fees based on baggage weight, ticket class and rate per kilogram. The calculation also includes 8% service tax."
                    android:textColor="#665A78"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="14dp" />

            </LinearLayout>

            <!-- GitHub Card -->
            <LinearLayout
                android:id="@+id/githubCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_lavender"
                android:padding="20dp"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↗  Explore on GitHub"
                    android:textColor="#403064"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/githubLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="github.com/luvnaa/FlyluneJava"
                    android:textColor="#6753AA"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Copyright -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 Flylune. All Rights Reserved."
                android:textColor="#8A7B9D"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
